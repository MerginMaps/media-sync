allowed_extensions:
 - jpg
 - png
operation_mode: copy
base_path:
driver: local

mergin:
  url: https://app.merginmaps.com
  username: media-sync
  password: super-secret
  project_name: media-sync/project

local:
  dest: /tmp/mediasync_copy

# AWS S3 or S3-compatible storage (driver: s3)
# Settings left empty here fall back to the deprecated `minio` section (MINIO__* variables), so keep them empty
s3:
  # name of the bucket (required)
  bucket:
  # AWS region (e.g. eu-west-1), required for AWS S3
  region:
  # leave empty for AWS S3; for S3-compatible servers host:port (with `secure`) or full URL, e.g. http://localhost:9000
  endpoint:
  # use https for endpoint without scheme (default: true)
  secure:
  # if keys are empty, AWS default credentials chain is used (AWS_* environment variables, IAM role, ...)
  access_key:
  secret_key:
  # optional folder within the bucket to store files in
  bucket_subpath:
  # optional base URL of the bucket written to references, e.g. when served through reverse proxy or CDN
  public_url:
  # auto (default), path or virtual - some S3-compatible servers need path
  addressing_style:
  # create the bucket if it does not exist (default: true)
  create_bucket:

google_drive:
  service_account_file: 
  folder:
  share_with:

# Optional: write URLs of uploaded media files into GeoPackage tables.
# Empty by default - uncomment and adjust the example below to enable it.
references: []
#references:
#  - file: survey.gpkg
#    table: notes
#    local_path_column: photo
#    driver_path_column: ext_url

daemon:
  # How often to synchronize (in seconds)
  sleep_time: 10
  # Failed attempts are retried with increasing wait time. The daemon exits after this number of consecutive
  # failed retries of its start (login, initial download) or unexpected errors (0 = never exit)
  max_failed_retries: 10
