# only media files with allowed extensions (under base_path) and reference geopackages are downloaded here.
# Mergin Maps auth token is stored in its parent directory (.mergin_auth.json) to be reused after restart
# instead of new login - when running in docker, mount the parent directory as a volume to keep it
project_working_dir: /tmp/mediasync
allowed_extensions:
 - jpg
 - png
operation_mode: copy
base_path:
driver: local

mergin:
  url: https://app.merginmaps.com
  username: media-sync
  password: super-secret
  project_name: media-sync/project

local:
  dest: /tmp/mediasync_copy

minio:
  endpoint: localhost:9000
  access_key: EXAMPLE
  secret_key: EXAMPLEKEY
  bucket: test
  secure: false
  region:
  bucket_subpath:
  public_url:

google_drive:
  service_account_file: 
  folder:
  share_with:

references:
  - file: survey.gpkg
    table: notes
    local_path_column: photo
    driver_path_column: ext_url

daemon:
  # How often to synchronize (in seconds)
  sleep_time: 10
  # Failed attempts are retried with increasing wait time. The daemon exits after this number of consecutive
  # failed retries of its start (login, initial download) or unexpected errors (0 = never exit)
  max_failed_retries: 10
